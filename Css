
/* NOVELVERSE WEBSITE STYLING */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    background: #0d0c14;
    color: #f5f2ff;
    font-family: Arial, sans-serif;
}

/* HEADER */

header {
    background: #171522;
    padding: 20px 7%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid #292536;
    position: sticky;
    top: 0;
    z-index: 100;
}

.logo {
    color: #b99aff;
    font-size: 25px;
    font-weight: bold;
}

nav a {
    color: #ddd8eb;
    text-decoration: none;
    margin-left: 20px;
    font-size: 14px;
}

nav a:hover {
    color: #bd9aff;
}

/* HERO */

.hero {
    padding: 80px 7%;
    background: linear-gradient(120deg, #211735, #10101b);
}

.hero h1 {
    font-size: 42px;
    max-width: 600px;
    margin-bottom: 15px;
}

.hero p {
    color: #b6b0c6;
    margin-bottom: 25px;
    line-height: 1.7;
}

.hero button {
    background: #a77af5;
    color: white;
    border: none;
    padding: 13px 24px;
    border-radius: 7px;
    cursor: pointer;
}

/* SECTIONS */

.section {
    padding: 45px 7%;
}

.section h2 {
    margin-bottom: 22px;
    font-size: 25px;
}

/* SEARCH */

.search-box {
    width: 100%;
    padding: 15px;
    background: #191725;
    border: 1px solid #383146;
    color: white;
    border-radius: 8px;
    margin-bottom: 20px;
    outline: none;
}

/* FILTERS */

.filters {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 25px;
}

.filters button {
    background: #201c2d;
    color: white;
    border: 1px solid #393148;
    padding: 9px 16px;
    border-radius: 20px;
    cursor: pointer;
}

.filters button.active,
.filters button:hover {
    background: #a77af5;
}

/* BOOK GRID */

.book-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(165px, 1fr));
    gap: 22px;
}

/* BOOK CARDS */

.book {
    background: #191725;
    border: 1px solid #2b2738;
    border-radius: 10px;
    overflow: hidden;
    transition: 0.3s;
}

.book:hover {
    transform: translateY(-5px);
    border-color: #a77af5;
}

.book img {
    width: 100%;
    height: 210px;
    object-fit: cover;
}

.book-info {
    padding: 13px;
}

.book-info h3 {
    font-size: 16px;
    margin-bottom: 7px;
}

.book-info p {
    color: #aaa3ba;
    font-size: 13px;
    margin-bottom: 12px;
}

.book-info button {
    width: 100%;
    background: #a77af5;
    color: white;
    border: none;
    padding: 10px;
    border-radius: 5px;
    cursor: pointer;
    margin-top: 5px;
}

.book-info button:hover {
    background: #8757db;
}

.favorite {
    background: #30283e !important;
}

/* READER */

.reader {
    display: none;
    position: fixed;
    inset: 0;
    background: #0d0c14;
    z-index: 200;
    overflow-y: auto;
    padding: 25px 7%;
}

.reader-content {
    max-width: 750px;
    margin: 35px auto;
}

.reader h2 {
    color: #c3a5ff;
    margin-bottom: 20px;
}

.reader p {
    font-size: 18px;
    line-height: 2;
    color: #e2ddeb;
    margin-bottom: 20px;
}

.reader button {
    padding: 12px 18px;
    border: none;
    border-radius: 6px;
    background: #a77af5;
    color: white;
    cursor: pointer;
    margin: 5px;
}

.close-btn {
    background: #382c49 !important;
}

/* LOGIN MODAL */

.modal {
    display: none;
    position: fixed;
    inset: 0;
    background: #000c;
    z-index: 300;
    justify-content: center;
    align-items: center;
    padding: 20px;
}

.modal-box {
    background: #191725;
    padding: 30px;
    border-radius: 12px;
    width: 100%;
    max-width: 380px;
}

.modal-box h2 {
    margin-bottom: 20px;
}

.modal-box input {
    width: 100%;
    padding: 13px;
    margin-bottom: 12px;
    border-radius: 6px;
    background: #0d0c14;
    border: 1px solid #383146;
    color: white;
}

.modal-box button {
    width: 100%;
    padding: 12px;
    margin-top: 8px;
    border: none;
    border-radius: 6px;
    background: #a77af5;
    color: white;
    cursor: pointer;
}

/* FOOTER */

footer {
    background: #171522;
    padding: 30px;
    text-align: center;
    color: #aaa3ba;
    margin-top: 40px;
}

/* MOBILE RESPONSIVENESS */

@media (max-width: 600px) {

    header {
        padding: 17px 5%;
        flex-wrap: wrap;
        gap: 12px;
    }

    nav a {
        margin-left: 9px;
        font-size: 12px;
    }

    .hero {
        padding: 60px 5%;
    }

    .hero h1 {
        font-size: 32px;
    }

    .section {
        padding: 30px 5%;
    }

    .book-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 12px;
    }

    .book img {
        height: 170px;
    }

    .reader p {
        font-size: 16px;
    }
}

